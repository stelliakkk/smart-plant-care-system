# =====================================================================
#  开发环境变量 (Vite 只把 VITE_ 开头的变量暴露给前端代码)
#  留空 = 走 vite.config.js 里的代理, 前端写相对路径, 同源无跨域问题
#  ★ 用手机访问时: 改成后端所在电脑的局域网地址
#     例如 VITE_API_BASE=http://192.168.3.14:8000
#     并在后端 .env 的 CORS_ORIGINS 里加上手机页面的地址
# =====================================================================
VITE_API_BASE=

# 留空时前端自动用 当前页面地址 + /ws
VITE_WS_URL=
