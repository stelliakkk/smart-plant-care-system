# =====================================================================
#  植物养护系统 - 后端配置模板
#  用法: 复制本文件为 .env, 再按实际情况修改
#        copy .env.example .env
#  ★ .env 已在 .gitignore 中排除, 内含密钥, 请勿提交到仓库
# =====================================================================

# ---------------------- 应用 ----------------------
APP_NAME=plant-care-backend
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# 允许跨域的前端地址 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------- 数据库 ----------------------
# 留空则默认使用 backend/data/plant.db (绝对路径, 不受启动目录影响)
# DATABASE_URL=sqlite:///D:/your/path/plant.db

# ---------------------- MQTT (与 ESP32 边缘端通信) ----------------------
# 本机已装 Mosquitto, 见 D:\SmartAgriBrainRuntime\mosquitto
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=plant-care-backend
MQTT_KEEPALIVE=60

# ---------------------- 边缘端设备 ----------------------
# 设备编号, 与 MQTT 主题里的 {device_id} 对应
DEVICE_ID=edge01

# ---------------------- DeepSeek 图像分析 ----------------------
# ★ 注意: 官方文档确认只有 deepseek-flash 支持图像输入,
#         deepseek-v4-pro 是纯文本模型, 传图片会报错
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60

# ---------------------- 摄像头 ----------------------
# 以下三个 USB 参数为旧配置兼容预留；CAM 分辨率在固件 app_config.h 中设置。
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
# 自动分析间隔 (秒), 0 = 关闭定时分析
VISION_INTERVAL_SEC=300
CAMERA_HTTP_TIMEOUT_SEC=20
VISION_RETENTION_DAYS=7
